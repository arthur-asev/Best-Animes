://cdn.myanimelist.net/images/anime/1565/111305t.jpg"},"webp":{"image_url":"https://cdn.myanimelist.net/images/anime/1565/111305.webp","large_image_url":"https://cdn.myanimelist.net/images/anime/1565/111305l.webp","small_image_url":"https://cdn.myanimelist.net/images/anime/1565/111305t.webp"}},"licensors":[{"mal_id":119,"name":"VIZ Media","type":"anime","url":"https://myanimelist.net/anime/producer/119/VIZ_Media"}],"mal_id":1735,"members":2677897,"popularity":15,"producers":[{"mal_id":16,"name":"TV Tokyo","type":"anime","url":"https://myanimelist.net/anime/producer/16/TV_Tokyo"},{"mal_id":17,"name":"Aniplex","type":"anime","url":"https://myanimelist.net/anime/producer/17/Aniplex"},{"mal_id":50,"name":"KSS","type":"anime","url":"https://myanimelist.net/anime/producer/50/KSS"},{"mal_id":211,"name":"Rakuonsha","type":"anime","url":"https://myanimelist.net/anime/producer/211/Rakuonsha"},{"mal_id":717,"name":"TV Tokyo Music","type":"anime","url":"https://myanimelist.net/anime/producer/717/TV_Tokyo_Music"}],"rank":324,"rating":"PG-13 - Teens 13 or older","score":8.28,"scored_by":1778678,"season":"winter","source":"Manga","status":"Finished Airing","studios":[{"mal_id":1,"name":"Studio Pierrot","type":"anime","url":"https://myanimelist.net/anime/producer/1/Studio_Pierrot"}],"synopsis":"It has been two and a half years since Naruto Uzumaki left Konohagakure, the Hidden Leaf Village, for intense training following events which fueled his desire to be stronger. Now Akatsuki, the mysterious organization of elite rogue ninja, is closing in on their grand plan which may threaten the safety of the entire shinobi world.\n \nAlthough Naruto is older and sinister events loom on the horizon, he has changed little in personality—still rambunctious and childish—though he is now far more confident and possesses an even greater determination to protect his friends and home. Come whatever may, Naruto will carry on with the fight for what is important to him, even at the expense of his own body, in the continuation of the saga about the boy who wishes to become Hokage.\n\n[Written by MAL Rewrite]","themes":[{"mal_id":17,"name":"Martial Arts","type":"anime","url":"https://myanimelist.net/anime/genre/17/Martial_Arts"}],"title":"Naruto: Shippuuden","title_english":"Naruto Shippuden","title_japanese":"-ナルト- 疾風伝","title_synonyms":["Naruto Hurricane Chronicles"],"titles":[{"title":"Naruto: Shippuuden","type":"Default"},{"title":"Naruto Hurricane Chronicles","type":"Synonym"},{"title":"-ナルト- 疾風伝","type":"Japanese"},{"title":"Naruto Shippuden","type":"English"},{"title":"Naruto Shippuden","type":"German"},{"title":"Naruto Shippuden","type":"Spanish"},{"title":"Naruto Shippuden","type":"French"}],"trailer":{"embed_url":"https://www.youtube-nocookie.com/embed/1dy2zPPrKD0?enablejsapi=1&wmode=opaque&autoplay=1","images":{"image_url":null,"large_image_url":null,"maximum_image_url":null,"medium_image_url":null,"small_image_url":null},"url":null,"youtube_id":null},"type":"TV","url":"https://myanimelist.net/anime/1735/Naruto__Shippuuden","year":2007},{"aired":{"from":"2009-08-01T00:00:00+00:00","prop":{"from":"[Object]","to":"[Object]"},"string":"Aug 1, 2009","to":null},"airing":false,"approved":true,"background":"Naruto: Shippuuden Movie 3 - Hi no Ishi wo Tsugu Mono is set approximately between the end of the \"Akatsuki Suppression Mission\" arc and the beginning of the \"Tale of Jiraiya the Gallant\" arc, covering episodes 88-129 of the Naruto: Shippuuden anime series. Celebrating both TV Tokyo's 45th anniversary and Naruto manga serialization's 10th anniversary, the movie was released on August 1, 2009 in Japan and registered a box office revenue of 1.02 billion yen. It was announced on the Naruto 10th anniversary site and an extended preview was shown during Japan Expo 2009 in France. While a DVD version was issued in Japan on April 21, 2010, English DVD and Blu-Ray versions were made available in the United States on October 23, 2012 by Viz Media. The movie also has an animanga adaptation; it was released in Japan on July 16, 2010.","broadcast":{"day":null,"string":null,"time":null,"timezone":null},"demographics":[{"mal_id":27,"name":"Shounen","type":"anime","url":"https://myanimelist.net/anime/genre/27/Shounen"}],"duration":"1 hr 35 min","episodes":1,"explicit_genres":[],"favorites":128,"genres":[{"mal_id":1,"name":"Action","type":"anime","url":"https://myanimelist.net/anime/genre/1/Action"},{"mal_id":2,"name":"Adventure","type":"anime","url":"https://myanimelist.net/anime/genre/2/Adventure"},{"mal_id":10,"name":"Fantasy","type":"anime","url":"https://myanimelist.net/anime/genre/10/Fantasy"}],"images":{"jpg":{"image_url":"https://cdn.myanimelist.net/images/anime/1493/116732.jpg","large_image_url":"https://cdn.myanimelist.net/images/anime/1493/116732l.jpg","small_image_url":"https://cdn.myanimelist.net/images/anime/1493/116732t.jpg"},"webp":{"image_url":"https://cdn.myanimelist.net/images/anime/1493/116732.webp","large_image_url":"https://cdn.myanimelist.net/images/anime/1493/116732l.webp","small_image_url":"https://cdn.myanimelist.net/images/anime/1493/116732t.webp"}},"licensors":[{"mal_id":119,"name":"VIZ Media","type":"anime","url":"https://myanimelist.net/anime/producer/119/VIZ_Media"}],"mal_id":6325,"members":220241,"popularity":1236,"producers":[{"mal_id":245,"name":"TOHO","type":"anime","url":"https://myanimelist.net/anime/producer/245/TOHO"}],"rank":2797,"rating":"PG-13 - Teens 13 or older","score":7.33,"scored_by":123381,"season":null,"source":"Manga","status":"Finished Airing","studios":[{"mal_id":1,"name":"Studio Pierrot","type":"anime","url":"https://myanimelist.net/anime/producer/1/Studio_Pierrot"}],"synopsis":"After being sent to investigate the alarming disappearance of four bloodline limit-wielding ninjas from different countries, Kakashi Hatake, Naruto Uzumaki, Sakura Haruno, and Sai successfully discover their whereabouts and inform the Hokage. Unexpectedly, Tsunade's further arrangements fall apart when Hiruko—the mastermind behind the incident and also a former Konohagakure ninja obsessed with power—appears to announce that he has absorbed the missing ninjas' unique abilities. On the verge of becoming invincible, he seeks one more bloodline limit before starting an all-out war to take over the world.\n\nAs Konohagakure's past connections with Hiruko raise suspicions among the nations about its involvement in the affair, Tsunade receives an ultimatum to solve the crisis. Left with no other choice, she decides to follow Kakashi's lead after he presents a daring yet salutary scheme—a proposal that could send him to certain death. However, Naruto opposes such a plan! Despite the Hokage's decision, he is determined to save his teacher's life, even if it means fighting friend and foe alike.\n\n[Written by MAL Rewrite]","themes":[],"title":"Naruto: Shippuuden Movie 3 - Hi no Ishi wo Tsugu Mono","title_english":"Naruto Shippuden the Movie 3: The Will of Fire","title_japanese":"ナルト- 疾風伝 火の意志を継ぐ者","title_synonyms":["Naruto Shippuuden: Gekijouban Naruto Shippuuden: Hi no Ishi o Tsugu Mono","Naruto Shippuuden Movie 3","Naruto Movie 6","Naruto Shippuuden 3: Inheritors of Will of Fire"],"titles":[{"title":"Naruto: Shippuuden Movie 3 - Hi no Ishi wo Tsugu Mono","type":"Default"},{"title":"Naruto Shippuuden: Gekijouban Naruto Shippuuden: Hi no Ishi o Tsugu Mono","type":"Synonym"},{"title":"Naruto Shippuuden Movie 3","type":"Synonym"},{"title":"Naruto Movie 6","type":"Synonym"},{"title":"Naruto Shippuuden 3: Inheritors of Will of Fire","type":"Synonym"},{"title":"ナルト- 疾風伝 火の意志を継ぐ者","type":"Japanese"},{"title":"Naruto Shippuden the Movie 3: The Will of Fire","type":"English"},{"title":"Naruto Shippuden Film 3: Die Erben des Willens des Feuers","type":"German"},{"title":"Naruto Shippuden Película 3: The Will of Fire","type":"Spanish"},{"title":"Naruto Shippuden Film 3: La Flamme de la Volonté","type":"French"}],"trailer":{"embed_url":"https://www.youtube-nocookie.com/embed/o0bDuM2tzi0?enablejsapi=1&wmode=opaque&autoplay=1","images":{"image_url":null,"large_image_url":null,"maximum_image_url":null,"medium_image_url":null,"small_image_url":null},"url":null,"youtube_id":null},"type":"Movie","url":"https://myanimelist.net/anime/6325/Naruto__Shippuuden_Movie_3_-_Hi_no_Ishi_wo_Tsugu_Mono","year":null},{"aired":{"from":"2012-04-03T00:00:00+00:00","prop":{"from":"[Object]","to":"[Object]"},"string":"Apr 3, 2012 to Mar 26, 2013","to":"2013-03-26T00:00:00+00:00"},"airing":false,"approved":true,"background":"Naruto SD: Rock Lee no Seishun Full-Power Ninden is a Naruto: Shippuuden non-canon spin-off. Unlike the original series, it is the work of a different author and presents distinctive elements: another main character, a super-deformed art style, a narrator, and topics or statements that can be difficult to understand even for adults. The first DVD was released on July 18, 2012. Starting October 1, 2013, the anime was re-broadcasted as a selection of episodes from the initial series under the title Naruto SD: Rock Lee no Seishun Full-Power Ninden Mou Iccho. It is also considered that Rock Lee Ocharake Gaiden—a separate feature shown in five installments as a bonus of Naruto Shippuuden—is essentially Naruto SD: Rock Lee no Seishun Full Power Ninden's predecessor. As of March 2015, both dubbed and subtitled English versions have been made available for online streaming in the United States through Hulu and Neon Alley.","broadcast":{"day":"Tuesdays","string":"Tuesdays at 18:00 (JST)","time":"18:00","timezone":"Asia/Tokyo"},"demographics":[{"mal_id":27,"name":"Shounen","type":"anime","url":"https://myanimelist.net/anime/genre/27/Shounen"}],"duration":"24 min per ep","episodes":51,"explicit_genres":[],"favorites":316,"genres":[{"mal_id":1,"name":"Action","type":"anime","url":"https://myanimelist.net/anime/genre/1/Action"},{"mal_id":4,"name":"Comedy","type":"anime","url":"https://myanimelist.net/anime/genre/4/Comedy"}],"images":{"jpg":{"image_url":"https://